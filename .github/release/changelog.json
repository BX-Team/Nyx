{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feat", "feature"]
    },
    {
      "title": "## 🐛 Fixes",
      "labels": ["fix", "bug"]
    },
    {
      "title": "## 🏎️ Performance",
      "labels": ["perf"]
    },
    {
      "title": "## 🏗 Refactor",
      "labels": ["refactor"]
    },
    {
      "title": "## 📝 Documentation",
      "labels": ["docs"]
    },
    {
      "title": "## 🔨 Build",
      "labels": ["build", "chore", "ci"]
    },
    {
      "title": "## 💅 Style",
      "labels": ["style"]
    },
    {
      "title": "## 💬 Other",
      "labels": []
    }
  ],
  "label_extractor": [
    {
      "pattern": "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style){1}(\\([\\w\\-\\.]+\\))?(!)?: ([\\w ])+([\\s\\S]*)",
      "on_property": "title",
      "target": "$1"
    }
  ]
}
